{
    "dependencies": {
        "@react-native-async-storage/async-storage": "2.1.0",
        "@react-native-community/datetimepicker": "8.2.0",
        "expo": "~52.0.0",
        "expo-constants": "~17.0.0",
        "expo-device": "~7.0.0",
        "expo-linking": "~7.0.0",
        "expo-notifications": "~0.29.0",
        "expo-router": "~4.0.0",
        "expo-status-bar": "~2.0.0",
        "react": "18.3.1",
        "react-native": "0.76.5",
        "react-native-safe-area-context": "4.12.0",
        "react-native-screens": "~4.1.0",
        "react-native-svg": "15.8.0",
        "zustand": "^5.0.2"
    },
    "description": "Cross-platform Todo app for Android and iOS with a modern alarm system and Pomodoro focus mode",
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@types/react": "~18.3.12",
        "typescript": "^5.3.3"
    },
    "main": "expo-router/entry",
    "name": "todo-app",
    "private": true,
    "scripts": {
        "android": "expo start --android",
        "doctor": "npx expo-doctor",
        "ios": "expo start --ios",
        "start": "expo start",
        "test": "node --experimental-strip-types --test src/lib/*.test.ts 2>/dev/null || echo \"Tests use Node type-stripping; see docs/SETUP.md\"",
        "typecheck": "tsc --noEmit",
        "web": "expo start --web"
    },
    "version": "1.0.0"
}
